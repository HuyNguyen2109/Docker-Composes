# Populated at deploy time from Vault (kubernetes/docker-secrets) — never commit .env
# AWS_ENDPOINTS is the HOST ONLY (no scheme): it is embedded inside the s3:// url in
# loki-config.yml; the https scheme is provided by the separate `endpoint:` field.
AWS_ENDPOINTS=s3.mcb-homelab.com
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
GRAFANA_ADMIN_PASSWORD=changeme